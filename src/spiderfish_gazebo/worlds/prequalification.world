<?xml version="1.0"?>
<sdf version="1.9">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <fluid_density>1000.00</fluid_density>
    <physics name="fast_simulation" type="ode">
      <max_step_size>0.01</max_step_size> <!-- Larger step size for faster simulation -->
      <real_time_update_rate>200</real_time_update_rate> <!-- 0 = as fast as possible, 100 = norma, 200= 2 times speed -->
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <light type="directional" name="sun">
      <pose>0 -2 2 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>1 1 1 1</specular>
      <attenuation>
        <range>100</range>
        <linear>0.01</linear>
        <constant>0.2</constant>
        <quadratic>0.0</quadratic>
      </attenuation>
      <direction>0 0 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <include>
        <pose>-2 -1 2 0 0 0</pose>
        <uri>model://prequalification_gate</uri>
    </include>

    <include>
        <pose>5 0 1 0 0 0</pose>
        <uri>model://prequalification_marker</uri>
    </include>

    <include>
      <uri>model://spiderfish_auv</uri>
      <pose>-5 0 1.2 0 0 0</pose>
    </include>

    <include>
        <pose>0 0 0 0 0 0</pose>
        <uri>model://woollett_pool</uri>
    </include>

  </world>
</sdf>