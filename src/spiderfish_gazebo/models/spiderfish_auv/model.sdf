<?xml version='1.0'?>
<sdf version='1.9'>
  <model name='spiderfish_auv'>
    <include>
      <uri>model://spiderfish_frame</uri>
      <pose>0 0 0 0 0 0</pose>
      <name>base_link</name>
    </include>

    <include>
      <uri>model://spiderfish_thruster</uri>
      <pose>-0.075 -0.39 0 -1.57 -1.57 1.57</pose>
      <name>thruster1</name>
    </include>

    <include>
      <uri>model://spiderfish_thruster</uri>
      <pose>0.33 -0.28 -0.0085 0 -2.355 1.57</pose>
      <name>thruster2</name>
    </include>

    <include>
      <uri>model://spiderfish_thruster</uri>
      <pose>0.33 0.152 -0.0085 0 2.355 1.57</pose>
      <name>thruster3</name>
    </include>

    <include>
      <uri>model://spiderfish_thruster</uri>
      <pose>-0.075 0.265 0 -1.57 1.57 1.57</pose>
      <name>thruster4</name>
    </include>
    
    <include>
      <uri>model://spiderfish_thruster</uri>
      <pose>-0.219431 -0.0625 0.08 0 3.14 1.57</pose>
      <name>thruster5</name>
    </include>

    <include>
      <uri>model://spiderfish_thruster</uri>
      <pose>-0.355 -0.07 0 1.57 1.57 0</pose>
      <name>thruster6</name>
    </include>

