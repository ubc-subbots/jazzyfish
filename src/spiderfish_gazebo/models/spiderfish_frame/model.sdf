<?xml version='1.0'?>
<sdf version='1.9'>
  <model name='spiderfish_frame'>
    <link name='base_link'>

      <inertial>
        <mass>32.9</mass>
        <inertia>
          <ixx>1.088853532</ixx>
          <ixy>0.000990367</ixy>
          <ixz>0.007434770</ixz>
          <iyy>1.025638212</iyy>
          <iyz>0.045963196</iyz>
          <izz>1.507000000</izz>
        </inertia>
        <pose>0.1 -0.062 -0.00878 0 0 0</pose>
      </inertial>

      <visual name='visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://spiderfish_frame/meshes/spiderfish_frame.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <lighting>1</lighting>
          <shader type='pixel'/>
        </material>
        <transparency>0</transparency>
        <cast_shadows>1</cast_shadows>
      </visual>

      <gravity>1</gravity>

      <collision name='collision'>
        <laser_retro>0</laser_retro>
        <max_contacts>2</max_contacts>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://spiderfish_frame/meshes/spiderfish_frame_collision.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
              <fdir1>0 0 0</fdir1>
              <slip1>0</slip1>
              <slip2>0</slip2>
            </ode>
            <torsional>
              <coefficient>1</coefficient>
              <patch_radius>0</patch_radius>
              <surface_radius>0</surface_radius>
              <use_patch_radius>1</use_patch_radius>
              <ode>
                <slip>0</slip>
              </ode>
            </torsional>
          </friction>
          <bounce>
            <restitution_coefficient>0</restitution_coefficient>
            <threshold>1e+06</threshold>
          </bounce>
          <contact>
            <collide_without_contact>0</collide_without_contact>
            <collide_without_contact_bitmask>1</collide_without_contact_bitmask>
            <collide_bitmask>1</collide_bitmask>
            <ode>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+13</kp>
              <kd>1</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0</min_depth>
            </ode>
            <bullet>
              <split_impulse>1</split_impulse>
              <split_impulse_penetration_threshold>-0.01</split_impulse_penetration_threshold>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+13</kp>
              <kd>1</kd>
            </bullet>
          </contact>
        </surface>
      </collision>
      
      <sensor type="depth_camera" name="front_camera">
        <pose>0.45 -0.06 0 0 0 0 </pose>
        <update_rate>60</update_rate>
        <visualize>false</visualize>
        <topic>/spiderfish/drivers/front_camera/depth/image_raw</topic>
        <camera name="front">
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>

      <sensor type="camera" name="down_camera">
        <pose>0.4 -0.06 0 0 1.57 0</pose>
        <update_rate>60</update_rate>
        <visualize>false</visualize>
        <topic>/spiderfish/drivers/down_camera/image_raw</topic>
        <camera name="down">
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>

      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>300</update_rate>
        <visualize>true</visualize>
        <topic>/spiderfish/drivers/imu</topic>
        <gravity>true</gravity>
        <pose>0 0 0 0 0 0</pose>
      </sensor>
    </link>

    <static>0</static>
    <allow_auto_disable>1</allow_auto_disable>
  </model>
</sdf>